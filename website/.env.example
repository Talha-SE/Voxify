MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=voxtral-mini-2507

GUMROAD_MEMBERSHIP_URL=https://yourname.gumroad.com/l/your-membership
GUMROAD_ONETIME_URL=https://yourname.gumroad.com/l/your-onetime-plan
GUMROAD_PRODUCT_ID=prod_xxx_membership
GUMROAD_PRODUCT_ID_STARTER=prod_xxx_starter
GUMROAD_PRODUCT_ID_PRO=prod_xxx_pro
GUMROAD_PRODUCT_ID_TEAM=prod_xxx_team
GUMROAD_PRODUCT_ID_LIFETIME=prod_xxx_lifetime
GUMROAD_API_ACCESS_TOKEN=

# Optional modern mapping for ONE product + many variants.
# Key is normalized variant label coming from Gumroad purchase payload.
VOXIFY_GUMROAD_VARIANT_RULES_JSON={"monthly starter":{"planCode":"starter","billingCycle":"monthly","priceType":"membership","seatLimit":1},"yearly starter":{"planCode":"starter","billingCycle":"yearly","priceType":"membership","seatLimit":1},"monthly pro":{"planCode":"pro","billingCycle":"monthly","priceType":"membership","seatLimit":5}}

ADMIN_USERNAME=brevios_admin
ADMIN_PASSWORD_HASH=generate_with_python_and_werkzeug
FLASK_SECRET_KEY=replace-with-a-long-random-secret-key
SESSION_SECURE_COOKIE=false
PORT=5050

# Master license key (unlimited admin usage, single device).
# Set this to your OWN secret key. The master-license feature is DISABLED
# when this is unset/empty — there is no hardcoded key in the code.
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(24))"
MASTER_LICENSE_KEY=
